{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil utilisateur avec rôle et statut d'accès",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["pending", "approved", "disabled"] },
        "dateCreation": { "type": "string" },
        "derniereConnexion": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status", "dateCreation"]
    },
    "Space": {
      "title": "Space",
      "description": "Espace de travail (Workspace) pour cloisonner tâches et projets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nom": { "type": "string" },
        "couleur": { "type": "string" },
        "icone": { "type": "string" },
        "description": { "type": "string" },
        "dateCreation": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "nom", "couleur", "dateCreation"]
    },
    "Project": {
      "title": "Project",
      "description": "Projet de regroupement de tâches dans un espace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nom": { "type": "string" },
        "couleur": { "type": "string" },
        "dateCreation": { "type": "string" },
        "userId": { "type": "string" },
        "spaceId": { "type": "string" },
        "deliverables": { "type": "array" },
        "teamMembers": { "type": "array" },
        "allocations": { "type": "array" },
        "raidLog": { "type": "array" }
      },
      "required": ["id", "nom", "couleur", "dateCreation", "spaceId"]
    },
    "Task": {
      "title": "Task",
      "description": "Tâche avec statut, projet, priorités, espace et commentaires",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titre": { "type": "string" },
        "description": { "type": "string" },
        "statut": { "type": "string" },
        "projetId": { "type": "string" },
        "spaceId": { "type": "string" },
        "dateEcheance": { "type": "string" },
        "dateRealisation": { "type": "string" },
        "dateModification": { "type": "string" },
        "ordre": { "type": "number" },
        "userId": { "type": "string" },
        "commentaires": { "type": "array" }
      },
      "required": ["id", "titre", "statut", "ordre", "spaceId"]
    },
    "RecurringTaskTemplate": {
      "title": "RecurringTaskTemplate",
      "description": "Modèle de tâche récurrente planifiée (inspiration Outlook)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "spaceId": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "recurrenceType": { "type": "string", "enum": ["daily", "weekly", "monthly", "workdays"] },
        "dayOfWeek": { "type": "number" },
        "dayOfMonth": { "type": "number" },
        "nextRunDate": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "lastGeneratedDate": { "type": "string" }
      },
      "required": ["id", "spaceId", "title", "recurrenceType", "nextRunDate", "isActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profil et rôle d'accès de l'utilisateur"
    },
    "/users/{userId}/spaces/{spaceId}": {
      "schema": "Space",
      "description": "Espaces de travail de l'utilisateur"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Projets de l'utilisateur"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tâches de l'utilisateur"
    },
    "/users/{userId}/recurringTemplates/{templateId}": {
      "schema": "RecurringTaskTemplate",
      "description": "Modèles de tâches récurrentes de l'utilisateur"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permet le test de connexion initial
    match /test/connection {
      allow read, write: if true;
    }

    // Collection des administrateurs
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Collection des profils utilisateurs et sous-collections
    match /users/{userId} {
      allow read, write: if true;

      // Sous-collections (espaces, projets, tâches)
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Règle globale de secours pour les collections de premier niveau
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


